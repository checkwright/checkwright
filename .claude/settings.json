{
  "attribution": {
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1"
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(bash gate-sdk/bin/run-gates.sh)",
      "Bash(bash gate-sdk/bin/run-gates.sh *)",
      "Bash(env GATE_SDK_VERBOSE=1 bash gate-sdk/bin/run-gates.sh)",
      "Bash(env GATE_SDK_VERBOSE=1 bash gate-sdk/bin/run-gates.sh *)",
      "Bash(./native/target/release/checkwright-gates)",
      "Bash(./native/target/release/checkwright-gates *)",
      "Bash(native/target/release/checkwright-gates)",
      "Bash(native/target/release/checkwright-gates *)",
      "Bash(env GATE_SDK_VERBOSE=1 ./native/target/release/checkwright-gates)",
      "Bash(env GATE_SDK_VERBOSE=1 ./native/target/release/checkwright-gates *)",
      "Bash(bash scripts/check-*.sh)",
      "Bash(bash scripts/check-*.sh *)",
      "Bash(bash gate-sdk/bin/build-native.sh)",
      "Bash(bash gate-sdk/bin/build-native.sh *)",
      "Bash(bash */checks/check-*.sh)",
      "Bash(bash */checks/check-*.sh *)",
      "Bash(bash */gate-tests/*.test.sh)",
      "Bash(bash */gate-tests/*.test.sh *)",
      "Bash(bash */smoke/install.sh)",
      "Bash(bash */smoke/violation.sh)",
      "Bash(bash installer/consumer-smoke/run-smoke.sh)",
      "Bash(bash installer/consumer-smoke/run-smoke.sh *)",
      "Bash(: > .workflow/prompt-friction.log)",
      "Bash(: > .workflow/knowledge-friction.log)",
      "Bash(: > .workflow/subagent-stop-liveness.log)",
      "Bash(rm .tmp/*)",
      "Bash(rm -f .tmp/*)",
      "Bash(rm -rf .tmp/*)",
      "Bash(git add *)",
      "Bash(git grep *)",
      "Bash(git commit -m *)",
      "Bash(git commit -q -m *)",
      "Bash(git rm -q *)",
      "Bash(git mv *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-remote *)",
      "Bash(git tag -l *)",
      "Bash(git check-ignore *)",
      "Bash(git ls-files *)",
      "Bash(git rev-list --count *)",
      "Bash(git merge-base *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo build *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(awk *)",
      "Bash(pgrep *)",
      "Bash(command -v *)",
      "Bash(python3 -*)",
      "Bash(shellcheck *)",
      "Bash(chmod +x *)",
      "Bash(mkdir -p *)",
      "Bash(mkdir *)",
      "Bash(date *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(wc *)",
      "Bash(head)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(git -C . add *)",
      "Bash(git -C . grep *)",
      "Bash(git -C . commit -m *)",
      "Bash(git -C . commit -q -m *)",
      "Bash(git -C . rm -q *)",
      "Bash(git -C . mv *)",
      "Bash(git -C . status)",
      "Bash(git -C . status *)",
      "Bash(git -C . log)",
      "Bash(git -C . log *)",
      "Bash(git -C . show *)",
      "Bash(git -C . diff)",
      "Bash(git -C . diff *)",
      "Bash(git -C . rev-parse *)",
      "Bash(git -C . ls-remote *)",
      "Bash(git -C . tag -l *)",
      "Bash(git -C . check-ignore *)",
      "Bash(git -C . ls-files *)",
      "Bash(git -C . rev-list --count *)",
      "Bash(git -C . merge-base *)",
      "Bash(gh auth status)",
      "Bash(gh auth status *)",
      "Bash(gh auth switch *)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash gate-sdk/bin/run-gates.sh --statusline"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/session-context.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash gate-sdk/bin/run-gates.sh --hook subagent-stop-liveness"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/bash-guard.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash gate-sdk/bin/run-gates.sh --hook agent-budget-guard"
          },
          {
            "type": "command",
            "command": "bash gate-sdk/bin/run-gates.sh --hook agent-dispatch-guard"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash gate-sdk/bin/run-gates.sh --hook workflow-state-guard"
          }
        ]
      }
    ]
  }
}
