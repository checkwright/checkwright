{
  "permissions": {
    "allow": [
      "Bash(bash tools/real-tool.sh)",
      "Bash(bash tools/removed-gate.sh)",
      "Bash(bash tools/removed-gate.sh *)",
      "Bash(env DEMO_FLAG=1 bash tools/removed-gate.sh)",
      "Bash(bash */checks/check-*.sh)",
      "Bash(git add *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/real-tool.sh"
          },
          {
            "type": "command",
            "command": "bash tools/removed-hook.sh"
          },
          {
            "type": "command",
            "command": "bash tools/run-gates.sh --hook no-such-guard"
          }
        ]
      }
    ]
  }
}
