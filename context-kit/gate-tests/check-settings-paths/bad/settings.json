{
  "permissions": {
    "allow": [
      "Bash(bash tools/real-tool.sh)",
      "Bash(bash tools/removed-gate.sh)",
      "Bash(bash tools/removed-gate.sh *)",
      "Bash(env DEMO_FLAG=1 bash tools/removed-gate.sh)",
      "Bash(bash */checks/check-*.sh)",
      "Bash(git add *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/real-tool.sh"
          },
          {
            "type": "command",
            "command": "bash tools/removed-hook.sh"
          },
          {
            "type": "command",
            "command": "bash tools/run-gates.sh --hook no-such-guard"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/@GATE_SDK_NATIVE_BIN@",
            "args": [
              "--hook",
              "shell-guard"
            ]
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/tools/checkwright-gates",
            "args": [
              "--hook",
              "no-such-exec-guard"
            ]
          }
        ]
      }
    ]
  }
}
