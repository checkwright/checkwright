# spec: evidence-kit/SPEC.md §Layout and configuration — this repo's evidence-kit consumer knob file; set only what this repo overrides beyond the kit defaults
EVIDENCE_KIT_SUITES[] = gates
# spec: evidence-kit/SPEC.md §Layout and configuration — the per-kit fixture suites, derived from the gate-tests dirs on disk, so a new kit's fixtures enrol with no edit here; their run members are pinned below; the suites after this line have no gate-tests dir and stay hand-listed
EVIDENCE_KIT_SUITES[] <- EVIDENCE_KIT_FIXTURE_SUITES
EVIDENCE_KIT_SUITES[] = guard_tests
EVIDENCE_KIT_SUITES[] = demo
EVIDENCE_KIT_SUITES[] = installer_smoke
EVIDENCE_KIT_SUITES[] = consumer_smoke
EVIDENCE_KIT_SUITES[] = upgrade
EVIDENCE_KIT_SUITES[] = agents_md_smoke
EVIDENCE_KIT_SUITES[] = index_tests
EVIDENCE_KIT_SUITES[] = native_crate
EVIDENCE_KIT_SUITES[] = projection_witness

# spec: evidence-kit/SPEC.md §Layout and configuration — per-gate scenarios for the gates suite; the verbose run is what emits the per-gate tails the parser reads
# spec: evidence-kit/SPEC.md §Layout and configuration — every RUN and PARSER value below is split and exec'd as a literal argv with no interpreter word, which is why they keep naming the front end after the door sweep: an exec'd argv reads no knob, so GATE_SDK_NATIVE_BIN spelled here would pass literally, and its resolved value would copy into nine rows what the knob owns. The front end resolves it for a caller that cannot (gate-sdk/SPEC.md §run-gates)
EVIDENCE_KIT_PARSER_gates = bash gate-sdk/bin/run-gates.sh --emit parse-gates-log
EVIDENCE_KIT_RUN_gates = env GATE_SDK_VERBOSE=1 bash gate-sdk/bin/run-gates.sh

# spec: evidence-kit/SPEC.md §Layout and configuration — per-arm scenarios for the installer smoke; the arm roster is the one the log declares at its head, and the suite's fail-fast shape is what turns an early abort into a red on every arm behind it rather than a hidden one
EVIDENCE_KIT_PARSER_installer_smoke = bash gate-sdk/bin/run-gates.sh --emit parse-smoke-log

# spec: evidence-kit/SPEC.md §check-battery-roster — the fixture suites' members pinned to the front end: the README register is contributor-facing and a pasted fence must head on a tracked path, which this tree's untracked binary is not; a new kit's suite takes the binary-door default until pinned here, and check-battery-roster's assertion A reds it in the README until then
EVIDENCE_KIT_RUN_gate_sdk = bash gate-sdk/bin/run-gates.sh --run-gate-tests gate-sdk/gate-tests gate-sdk/checks
EVIDENCE_KIT_RUN_canon_kit = bash gate-sdk/bin/run-gates.sh --run-gate-tests canon-kit/gate-tests canon-kit/checks
EVIDENCE_KIT_RUN_context_kit = bash gate-sdk/bin/run-gates.sh --run-gate-tests context-kit/gate-tests context-kit/checks
EVIDENCE_KIT_RUN_delegation_kit = bash gate-sdk/bin/run-gates.sh --run-gate-tests delegation-kit/gate-tests delegation-kit/checks
EVIDENCE_KIT_RUN_doctrine_kit = bash gate-sdk/bin/run-gates.sh --run-gate-tests doctrine-kit/gate-tests doctrine-kit/checks
EVIDENCE_KIT_RUN_evidence_kit = bash gate-sdk/bin/run-gates.sh --run-gate-tests evidence-kit/gate-tests evidence-kit/checks
EVIDENCE_KIT_RUN_guard_kit = bash gate-sdk/bin/run-gates.sh --run-gate-tests guard-kit/gate-tests guard-kit/checks
EVIDENCE_KIT_RUN_lifecycle_kit = bash gate-sdk/bin/run-gates.sh --run-gate-tests lifecycle-kit/gate-tests lifecycle-kit/checks
EVIDENCE_KIT_RUN_queue_kit = bash gate-sdk/bin/run-gates.sh --run-gate-tests queue-kit/gate-tests queue-kit/checks
EVIDENCE_KIT_RUN_site_kit = bash gate-sdk/bin/run-gates.sh --run-gate-tests site-kit/gate-tests site-kit/checks
EVIDENCE_KIT_RUN_scripts = bash gate-sdk/bin/run-gates.sh --run-gate-tests scripts/gate-tests

EVIDENCE_KIT_RUN_guard_tests = bash gate-sdk/bin/run-gates.sh --run-guard-tests
EVIDENCE_KIT_RUN_demo = bash gate-sdk/bin/run-gates.sh --run-demo
EVIDENCE_KIT_RUN_installer_smoke = bash gate-sdk/bin/run-gates.sh --installer-smoke
EVIDENCE_KIT_RUN_consumer_smoke = bash gate-sdk/bin/run-gates.sh --run-consumer-smoke
EVIDENCE_KIT_RUN_upgrade = bash gate-sdk/bin/run-gates.sh --upgrade-smoke
EVIDENCE_KIT_RUN_agents_md_smoke = bash gate-sdk/bin/run-gates.sh --agents-md-smoke
EVIDENCE_KIT_RUN_index_tests = bash gate-sdk/bin/run-gates.sh --run-index-tests
EVIDENCE_KIT_RUN_native_crate = cargo test --release --manifest-path native/Cargo.toml
EVIDENCE_KIT_RUN_projection_witness = bash gate-sdk/bin/run-gates.sh --projection-witness
