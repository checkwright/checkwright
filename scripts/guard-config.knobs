GUARD_KIT_RO_BINS[] = nl
GUARD_KIT_RO_BINS[] = rev
GUARD_KIT_RO_BINS[] = tac
GUARD_KIT_RO_BINS[] = paste
GUARD_KIT_RO_BINS[] = comm
GUARD_KIT_RO_BINS[] = column
GUARD_KIT_RO_BINS[] = diff
GUARD_KIT_RO_BINS[] = jq
GUARD_KIT_RO_BINS[] = find
GUARD_KIT_RO_BINS[] = ls
