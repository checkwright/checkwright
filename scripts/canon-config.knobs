# spec: canon-kit/SPEC.md §Layout and configuration — this repo's canon-kit consumer knob file

# spec: canon-kit/SPEC.md §Layout and configuration — the design-pending section set is deferred plus icebox; this repo runs the icebox tier, so its canon-kit counterpart of QUEUE_KIT_ICEBOX_SECTION is set here
CANON_KIT_ICEBOX_SECTION = Icebox

# comment-tier-exempt: this repo's component specs ARE the kit SPECs (a reference-spec corpus with no Definition-of-Done), so DoD-singleton runs at-most-one
CANON_KIT_DOD_MODE = at-most-one

# comment-tier-exempt: the kits are this repo's own first-party components, so the spec finders scan their SPEC.md rather than prune them as vendored roots
CANON_KIT_SCAN_KIT_ROOTS = 1

# comment-tier-exempt: this repo's ruling record and its local-only brief, the private surfaces a kit SPEC must never point into — their spellings are this publisher's vocabulary, so they ride consumer config rather than a kit literal
CANON_KIT_SEAM_PRIVATE_SURFACES[] = TRAJECTORY.md
CANON_KIT_SEAM_PRIVATE_SURFACES[] = BRIEF.local.md

# comment-tier-exempt: installer/ is repo-root-governed rather than a kit, yet its SPEC is published on the repository and the docs mirror, so the provenance arms hold it as this tree's own seam surface
CANON_KIT_SEAM_SURFACE_GLOBS[] = installer/SPEC.md

# comment-tier-exempt: deliberate-absence rulings may narrate what the kit excludes — an "Out of scope" section states what a kit does not carry and why, so the whole section is exempt from the temporal-narration gate
CANON_KIT_TEMPORAL_EXEMPT_SECTIONS[] = Out of scope

# comment-tier-exempt: the docs/ site joins the governed manifest set by explicit wiring — this knob replaces the default set, so it enumerates the prior default (CLAUDE.md, README.md at any depth, kit SPEC.md/README.md — single-level globs skip the gate-tests/ fixtures the finder pruned) plus the docs/ living pages, the dated posts, the root contribution, conduct, disclosure, release, public-direction and ruling-record surfaces (CONTRIBUTING.md, CODE_OF_CONDUCT.md, SECURITY.md, RELEASING.md, ROADMAP.md, TRAJECTORY.md), and the doctrine deliverable (doctrine-kit/DOCTRINE.md) so its links and commands resolve under the doc gates
CANON_KIT_MANIFEST_FILES[] = CLAUDE.md
CANON_KIT_MANIFEST_FILES[] = README.md
CANON_KIT_MANIFEST_FILES[] = CONTRIBUTING.md
CANON_KIT_MANIFEST_FILES[] = CODE_OF_CONDUCT.md
CANON_KIT_MANIFEST_FILES[] = SECURITY.md
CANON_KIT_MANIFEST_FILES[] = RELEASING.md
CANON_KIT_MANIFEST_FILES[] = ROADMAP.md
CANON_KIT_MANIFEST_FILES[] = TRAJECTORY.md
CANON_KIT_MANIFEST_FILES[] = */SPEC.md
CANON_KIT_MANIFEST_FILES[] = */README.md
CANON_KIT_MANIFEST_FILES[] = reserve/*/README.md
CANON_KIT_MANIFEST_FILES[] = doctrine-kit/DOCTRINE.md
CANON_KIT_MANIFEST_FILES[] = docs/*.md
CANON_KIT_MANIFEST_FILES[] = docs/*/index.md
CANON_KIT_MANIFEST_FILES[] = docs/posts/*.md

# comment-tier-exempt: dated posts under docs/posts/ are immutable published artifacts whose dated narrative is their nature — a heading name cannot address a whole-file class, so the path valve exempts them from temporal-narration governance and retired-path citation while link and fenced-command resolution still apply
CANON_KIT_TEMPORAL_EXEMPT_PATHS[] = docs/posts/*

# comment-tier-exempt: this repo's ruling-record idiom, extending the bundled marker set rather than replacing it — a spelling of one project's ruling-record dialect is consumer config for the same provenance-seam reason the transport and payload-disclosure vocabularies below are; the first three catch the appended-correction shape TRAJECTORY.md's completion-time contract retires, and the fourth catches a ruling labelled finished and kept as a fixture, which is the failure that contract exists to end; the broader 'is spent' was measured safe and narrowed anyway, because a marker that constrains how the rule itself may be written is a marker that will be valved
CANON_KIT_TEMPORAL_MARKERS_EXTRA[] = correction appended
CANON_KIT_TEMPORAL_MARKERS_EXTRA[] = stands unstruck
CANON_KIT_TEMPORAL_MARKERS_EXTRA[] = when written
CANON_KIT_TEMPORAL_MARKERS_EXTRA[] = the ruling is spent

# comment-tier-exempt: reserve/ is the crates.io name-reservation placeholder, not developed in (CLAUDE.md §Housekeeping) — its lib.rs carries the registry blurb crates.io renders, which is the file's whole purpose and answers to no SPEC section
CANON_KIT_COMMENT_WHITELIST[] = reserve/*

# comment-tier-exempt: this repo's history-bearing surfaces, held out of check-amendment-retired-spelling's reconciliation corpus — which surfaces record what a change retired rather than carrying it live is a consumer fact, so no kit default can name them: the work queue and the ruling record narrate retirements by name, .workflow/ holds the audit and survey records that do the same, and a gate-tests/ tree is fixture text a live-tree finding must never be read out of
CANON_KIT_RETIRED_SPELLING_EXCLUDE[] = TASK-QUEUE.md
CANON_KIT_RETIRED_SPELLING_EXCLUDE[] = TRAJECTORY.md
CANON_KIT_RETIRED_SPELLING_EXCLUDE[] = .workflow/*
CANON_KIT_RETIRED_SPELLING_EXCLUDE[] = */gate-tests/*

# comment-tier-exempt: this repo's install transports and the sections they are held over — the vocabulary is consumer config because a kit literal spelling a transport would publish one project's distribution model; the section regex is anchored so a heading merely mentioning a script name (### install-hooks) never selects, and the posts valve keeps a published release note immutable the same way CANON_KIT_TEMPORAL_EXEMPT_PATHS already does
CANON_KIT_INSTALL_TRANSPORTS_CMD[] = bash
CANON_KIT_INSTALL_TRANSPORTS_CMD[] = scripts/install-transports.sh
CANON_KIT_INSTALL_SECTION_RE = ^(Quick start|Install)
CANON_KIT_INSTALL_CLAIM_EXCLUDE[] = docs/posts/*

# comment-tier-exempt: this repo's payload-disclosure vocabulary — a spelling of what a payload discloses is one project's distribution model, so it is consumer config for the same provenance-seam reason the transport vocabulary above is; the posts valve keeps a published dated note immutable, the same way CANON_KIT_INSTALL_CLAIM_EXCLUDE and CANON_KIT_TEMPORAL_EXEMPT_PATHS already do
CANON_KIT_PAYLOAD_CLAIMS_CMD[] = bash
CANON_KIT_PAYLOAD_CLAIMS_CMD[] = scripts/payload-claims.sh
CANON_KIT_PAYLOAD_CLAIM_EXCLUDE[] = docs/posts/*

# comment-tier-exempt: the site's per-kit index pages, each restating part of the kit README mirrored beside it; which pages restate a source is this site's layout, never a kit literal
CANON_KIT_RESTATEMENT_PAGES[] = docs/*/index.md

# comment-tier-exempt: this repo's measured-claim oracle and the surface its markers are read from — the keys and the facts behind them are consumer config for the same provenance-seam reason the transport and payload vocabularies are, and the surface is the governed manifest set widened by the stage-skill shims, which carry governed prose no other surface reaches (the prose surface excludes them by an ownership decision about copy shape, which is not the ownership this gate's rule needs), and by the work queue, which takes the marker without taking the manifest tier's bare-cardinal ban (canon-kit/SPEC.md §check-manifest-count)
CANON_KIT_MEASURED_CLAIMS_CMD[] = bash
CANON_KIT_MEASURED_CLAIMS_CMD[] = scripts/measured-claims.sh
CANON_KIT_MEASURED_SURFACE_GLOBS[] <- CANON_KIT_MANIFEST_FILES
CANON_KIT_MEASURED_SURFACE_GLOBS[] = .claude/commands/*.md
CANON_KIT_MEASURED_SURFACE_GLOBS[] = TASK-QUEUE.md
# comment-tier-exempt: this repo keeps its markdown unwrapped (CANON_KIT_UNWRAP_GLOBS below), so a paragraph is one line of any length and a full-line marker binds its own first sentence rather than whatever cardinal the paragraph carries further on
CANON_KIT_MEASURED_SPAN = sentence

# comment-tier-exempt: this repo's claim-class roster — the classes are consumer config for the same provenance-seam reason the transport, payload and measured vocabularies above are, and more sharply: the roster spells this project's own positioning vocabulary, so a kit literal carrying it would publish it and canon-kit/SPEC.md would match its own class while describing it; the scanned surface is CANON_KIT_MEASURED_SURFACE_GLOBS above rather than a second knob, since every site the class reaches already falls inside it
CANON_KIT_CLAIM_CLASSES_CMD[] = bash
CANON_KIT_CLAIM_CLASSES_CMD[] = scripts/claim-classes.sh

# spec: canon-kit/SPEC.md §check-knob-citation — this repo binds the shipped reach, the distance its prose was measured at when its markdown was unwrapped; sentence is unmeasured here, and switching to it would be a verdict change
CANON_KIT_KNOB_CITATION_REACH = 100
# spec: canon-kit/SPEC.md §check-knob-citation — this repo binds the shipped literal span, the one the citation gate is green at on this tree
CANON_KIT_KNOB_CITATION_LITERAL_SPAN = 24
# spec: canon-kit/SPEC.md §check-knob-default-coupling — this repo binds the shipped window, at which the coupling gate is green on this tree
CANON_KIT_DEFAULT_COUPLING_WINDOW = 400

# comment-tier-exempt: the enum-set emitter derives the queue-tag set from queue-kit's own tag parser plus this repo's lesson tags, so a prose enumeration of the tag vocabulary that drops a member is caught rather than trusted
CANON_KIT_ENUM_SETS_CMD[] = bash
CANON_KIT_ENUM_SETS_CMD[] = gate-sdk/bin/run-gates.sh
CANON_KIT_ENUM_SETS_CMD[] = --emit
CANON_KIT_ENUM_SETS_CMD[] = enum-sets

# comment-tier-exempt: the slot-free kit-template and agent-definition surfaces this repo governs — the finder includes a candidate iff it bears no binding slot, so slot-bearing templates (lead.md, the stage skills, agent-execution.md) self-exclude; the stage-skill shims under .claude/commands/ stay out (they are consumer bindings, governed by check-skill-binding/check-shim-restatement)
CANON_KIT_PROSE_SURFACE_GLOBS[] = */templates/*.md
CANON_KIT_PROSE_SURFACE_GLOBS[] = .claude/agents/*.md

# comment-tier-exempt: this repo's governed-source surface, set so the corpus arrives through the knob the descriptors couple to rather than through the kit's default branch. The knob-file glob is the one widening past the kit default branch, which scans no `.knobs`: a static kit's consumer knob file carries `#` comments the tier governs, and the gate's default comment style reads them
CANON_KIT_COMMENT_SURFACE[] = **/*.sh
CANON_KIT_COMMENT_SURFACE[] = **/*.gate
CANON_KIT_COMMENT_SURFACE[] = **/*.rs
CANON_KIT_COMMENT_SURFACE[] = **/*.knobs

# comment-tier-exempt: the programs this repo's shell fences name beyond the bundled generic utility set — the crate toolchain its contributor battery runs, the fetch and checksum tools its install recipes use, and the package manager one platform's install recipe names, and the npm runner the one-command install uses; a tree's toolchain is its own vocabulary, never a kit literal (the provenance seam)
CANON_KIT_FENCE_PROGRAMS_EXTRA[] = cargo
CANON_KIT_FENCE_PROGRAMS_EXTRA[] = curl
CANON_KIT_FENCE_PROGRAMS_EXTRA[] = sha256sum
CANON_KIT_FENCE_PROGRAMS_EXTRA[] = shasum
CANON_KIT_FENCE_PROGRAMS_EXTRA[] = brew
CANON_KIT_FENCE_PROGRAMS_EXTRA[] = npx

# comment-tier-exempt: this repo's reader-facing prose surfaces for check-prose-tells — the hand-authored top-level docs living pages only; the single-level docs/*.md glob deliberately excludes the generated kit mirror (docs/<kit>/) and the immutable dated posts (docs/posts/), since a prose gate forcing edits to generated or immutable pages contradicts them; consumer editorial scope, never a kit literal (the provenance seam)
CANON_KIT_PROSE_TELL_GLOBS[] = docs/*.md

# comment-tier-exempt: tokens this repo's audience reads as jargon-free and so exempt from the undefined-abbreviation tell — this repo's own standard names alongside industry terms nobody expands on an install page; consumer vocabulary, never a kit literal (the provenance seam)
CANON_KIT_PROSE_TELL_ABBR_ALLOW_EXTRA[] = SPEC
CANON_KIT_PROSE_TELL_ABBR_ALLOW_EXTRA[] = KPI
CANON_KIT_PROSE_TELL_ABBR_ALLOW_EXTRA[] = README
CANON_KIT_PROSE_TELL_ABBR_ALLOW_EXTRA[] = CNAME
CANON_KIT_PROSE_TELL_ABBR_ALLOW_EXTRA[] = CLAUDE
CANON_KIT_PROSE_TELL_ABBR_ALLOW_EXTRA[] = DOCTRINE
CANON_KIT_PROSE_TELL_ABBR_ALLOW_EXTRA[] = ROADMAP
CANON_KIT_PROSE_TELL_ABBR_ALLOW_EXTRA[] = GNU
CANON_KIT_PROSE_TELL_ABBR_ALLOW_EXTRA[] = BSD

# comment-tier-exempt: this repo keeps its tracked markdown unwrapped, one line per paragraph, the queue and its shipped template included; gate-test fixtures are held out because a fixture's line shape is the input under test — consumer editorial scope, never a kit literal (the provenance seam)
CANON_KIT_UNWRAP_GLOBS[] = *.md
CANON_KIT_UNWRAP_EXCLUDE[] = */gate-tests/*
# comment-tier-exempt: the three line leads this repo's own readers key on — lifecycle-kit's ruling-staleness probe reads `ruling:` and `discharge:`, and the close-surface roster reads `close-surface:`; the unwrap joining one onto the paragraph above disarms its reader, so each opens a block here
CANON_KIT_UNWRAP_DECLARATION_LEADS[] = ruling:
CANON_KIT_UNWRAP_DECLARATION_LEADS[] = discharge:
CANON_KIT_UNWRAP_DECLARATION_LEADS[] = close-surface:

# spec: canon-kit/SPEC.md §Layout and configuration — the policy calibrations this repo relies on, bound at the values its gates are green at so a kit default's move moves no verdict here: the kit's author is a consumer that binds its own (Policy-as-choice). CANON_KIT_SEAM_AUTHORITY_MARKERS stays inherited because its default member `lead, ` ends in a blank a knob file cannot express
CANON_KIT_COMMENT_RUN_CAP = 3
CANON_KIT_COUNT_WEDGE_WORDS = 2
CANON_KIT_DERIVABLE_DENSITY = 60
CANON_KIT_DERIVABLE_POINTER_REGEX = pub-index|proto-index
CANON_KIT_EMBED_THRESHOLD = 0.70
CANON_KIT_EMBED_MINLINES = 8
CANON_KIT_EMBED_WIRE_KIND = proto
CANON_KIT_EMBED_ILLUSTRATIVE[] = json
CANON_KIT_SEAM_SLUG_MIN_LEN = 12
CANON_KIT_PROSE_TELL_EMDASH_MAX = 2
CANON_KIT_PROSE_TELL_CONTRAST_MAX = 1
CANON_KIT_PROSE_TELL_TRICOLON_MAX = 2
CANON_KIT_PROSE_TELL_RHYTHM_MIN_SENTENCES = 4
CANON_KIT_PROSE_TELL_RHYTHM_CV_MIN = 0.25
CANON_KIT_PROSE_TELL_ABBR_MIN_LEN = 3
CANON_KIT_BANNED_HEADINGS[] = Directory Structure
CANON_KIT_BANNED_HEADINGS[] = Public API
CANON_KIT_BANNED_HEADINGS[] = Cargo.toml Dependencies
CANON_KIT_COUNT_COLLECTIONS[] = gates
CANON_KIT_COUNT_COLLECTIONS[] = meta-gates
CANON_KIT_COUNT_COLLECTIONS[] = checks
CANON_KIT_COUNT_COLLECTIONS[] = kits
CANON_KIT_COUNT_COLLECTIONS[] = stages
CANON_KIT_COUNT_COLLECTIONS[] = rules
CANON_KIT_COUNT_COLLECTIONS[] = KPIs
CANON_KIT_TEMPORAL_MARKERS[] = previously
CANON_KIT_TEMPORAL_MARKERS[] = formerly
CANON_KIT_TEMPORAL_MARKERS[] = renamed from
CANON_KIT_TEMPORAL_MARKERS[] = no longer
CANON_KIT_TEMPORAL_MARKERS[] = used to be
CANON_KIT_TEMPORAL_MARKERS[] = was (retired|removed|renamed|replaced)
CANON_KIT_PROSE_TELL_PHRASES[] = It's worth noting
CANON_KIT_PROSE_TELL_PHRASES[] = It is worth noting
CANON_KIT_PROSE_TELL_PHRASES[] = It's important to note
CANON_KIT_PROSE_TELL_PHRASES[] = That said
CANON_KIT_PROSE_TELL_PHRASES[] = Needless to say
CANON_KIT_PROSE_TELL_PHRASES[] = It goes without saying
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = API
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = CLI
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = URL
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = HTML
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = CSS
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = JSON
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = YAML
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = CI
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = SDK
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = SSO
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = DNS
CANON_KIT_PROSE_TELL_ABBR_ALLOW[] = HTTPS
CANON_KIT_FENCE_RUN_PROGRAMS[] = git
CANON_KIT_FENCE_PROGRAMS[] = awk
CANON_KIT_FENCE_PROGRAMS[] = basename
CANON_KIT_FENCE_PROGRAMS[] = bash
CANON_KIT_FENCE_PROGRAMS[] = cat
CANON_KIT_FENCE_PROGRAMS[] = chmod
CANON_KIT_FENCE_PROGRAMS[] = cmp
CANON_KIT_FENCE_PROGRAMS[] = cp
CANON_KIT_FENCE_PROGRAMS[] = cut
CANON_KIT_FENCE_PROGRAMS[] = date
CANON_KIT_FENCE_PROGRAMS[] = diff
CANON_KIT_FENCE_PROGRAMS[] = dirname
CANON_KIT_FENCE_PROGRAMS[] = env
CANON_KIT_FENCE_PROGRAMS[] = expr
CANON_KIT_FENCE_PROGRAMS[] = find
CANON_KIT_FENCE_PROGRAMS[] = git
