# Fixture config: make the sandbox kits the kit roots, so gate_kit_roots resolves
# to this case dir (read by the gate binary at cwd) rather than the real repo, and
# pin a non-empty publisher base so assertion A packs under a real location rather
# than the gate's own probe. See gate-sdk/SPEC.md §Layout and configuration.
GATE_SDK_KIT_DIRS = alpha-kit beta-kit gamma-kit
GATE_SDK_SPEC_BASE_URL = https://fixture.test
