# The candidate glob the finder discriminates: the slot-bearing cand-tmpl.md is
# excluded, so its dangling citation is never scanned.
CANON_KIT_PROSE_SURFACE_GLOBS[] = cand-*.md
# The widget spec joins the manifest set, so a pathless citation resolves against it.
CANON_KIT_MANIFEST_FILES[] = README.md
CANON_KIT_MANIFEST_FILES[] = SPEC-widget.md
# A heading family joins it, so a citation of one member resolves only whole.
CANON_KIT_MANIFEST_FILES[] = SPEC-family.md
# A Rust consumer brings its language into the derived surface through the knob.
CANON_KIT_COMMENT_SURFACE[] = **/*.sh
CANON_KIT_COMMENT_SURFACE[] = **/*.gate
CANON_KIT_COMMENT_SURFACE[] = **/*.rs
