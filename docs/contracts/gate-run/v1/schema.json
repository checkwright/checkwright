{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkwright.dev/contracts/gate-run/v1/schema.json",
  "title": "Checkwright gate-run Statement, predicate v1",
  "description": "An in-toto Statement v1 whose subject is the commit a validate run tested and whose predicate records each suite's command, log, counts and verdict. Unsigned as written; a signer wraps it in a DSSE envelope. A reader refuses a predicateType or a contract major it does not know, and ignores fields it does not know.",
  "type": "object",
  "required": ["_type", "predicate", "predicateType", "subject"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "predicateType": { "const": "https://checkwright.dev/gate-run/v1" },
    "subject": {
      "description": "One resource descriptor: the commit the run tested.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["digest"],
        "properties": {
          "digest": {
            "type": "object",
            "required": ["gitCommit"],
            "properties": {
              "gitCommit": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" }
            }
          }
        }
      }
    },
    "predicate": {
      "type": "object",
      "required": ["contract", "provenance", "run", "suites"],
      "properties": {
        "contract": {
          "description": "The predicate's version, a Semantic Versioning 2.0 string; this major is 1.",
          "type": "string",
          "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
        },
        "run": {
          "description": "The run key: the iteration, else the consumer's run id.",
          "type": "string"
        },
        "provenance": {
          "description": "The provenance block the verdict contract defines (tool, kits, commit, worktree), embedded whole.",
          "type": "object",
          "required": ["kits", "tool"],
          "dependentRequired": { "commit": ["worktree"], "worktree": ["commit"] },
          "properties": {
            "tool": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 },
                "sourceStamp": { "type": "string", "minLength": 1 },
                "target": { "type": "string", "minLength": 1 }
              }
            },
            "kits": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "root"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "root": { "type": "string", "minLength": 1 },
                  "version": { "type": "string", "minLength": 1 }
                }
              }
            },
            "commit": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
            "worktree": { "enum": ["clean", "modified"] }
          }
        },
        "suites": {
          "description": "One object per suite the run ran, in configured-suite order.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["binding", "command", "counts", "date", "log", "name", "tree", "verdict"],
            "properties": {
              "name": { "type": "string", "pattern": "^\\S+$" },
              "command": {
                "description": "SHA-256 of the newline-terminated lines 'run <words>' and 'parser <words>'.",
                "type": "object",
                "required": ["sha256"],
                "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
              },
              "log": {
                "description": "SHA-256 of the suite's captured log.",
                "type": "object",
                "required": ["sha256"],
                "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
              },
              "counts": {
                "type": "object",
                "required": ["fail", "ignore", "pass"],
                "properties": {
                  "pass": { "type": "integer", "minimum": 0 },
                  "fail": { "type": "integer", "minimum": 0 },
                  "ignore": { "type": "integer", "minimum": 0 }
                }
              },
              "verdict": { "enum": ["clean", "new-failures"] },
              "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
              "tree": {
                "description": "The worktree state when the suite started; 'modified' ran on content that is not the subject commit.",
                "enum": ["clean", "modified"]
              },
              "binding": {
                "description": "SHA-256 of the newline-terminated lines 'gate-run-binding v1', suite, command digest, commit, '<pass> <fail> <ignore>', verdict, log digest.",
                "type": "object",
                "required": ["sha256"],
                "properties": { "sha256": { "$ref": "#/$defs/sha256" } }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
